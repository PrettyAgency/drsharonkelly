<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IIS in-process hosting (fastest, recommended for IIS 10 / Windows Server 2022) -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <!-- No third-party NuGet packages required — uses built-in System.Net.Mail for SMTP.
         If you'd rather use MailKit/MimeKit (recommended long-term, SmtpClient is legacy),
         add:
           <PackageReference Include="MailKit" Version="4.*" />
         and swap EmailSender's internals — the public interface (SendAsync) stays the same. -->
  </ItemGroup>

</Project>
